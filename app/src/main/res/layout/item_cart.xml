<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="150dp"
    android:layout_height="140dp"
    android:layout_margin="8dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="6dp"
    app:cardBackgroundColor="?attr/colorSurfaceVariant">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/cart_item_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/bottom_white_bar"
            android:scaleType="centerCrop"
            android:contentDescription="Imagen del producto en carrito"
            android:src="@drawable/restaurante" />

        <TextView
            android:id="@+id/item_stock_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:background="?attr/colorOnSurface"
            android:paddingHorizontal="4dp"
            android:paddingVertical="2dp"
            android:text="Stock: 0"
            android:textColor="?attr/colorSurface"
            android:textSize="8sp"
            android:textStyle="bold"
            android:gravity="center"
            android:elevation="4dp"
            android:visibility="gone"/>

        <LinearLayout
            android:id="@+id/bottom_white_bar"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_alignParentBottom="true"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/colorSurface"
            android:paddingHorizontal="4dp"
            android:elevation="6dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cart_minus_button"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:elevation="4dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="-"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="14sp"
                app:backgroundTint="?attr/colorSecondary"
                app:cornerRadius="100dp"
                tools:ignore="TouchTargetSizeCheck" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="start">

                <TextView
                    android:id="@+id/cart_item_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nombre de plato"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/cart_item_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="S/ 0.00"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="8sp"
                    android:layout_marginTop="0dp" />

                <TextView
                    android:id="@+id/cart_item_quantity_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1"
                    android:textColor="?attr/colorError"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp"
                    android:visibility="gone" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cart_add_button"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:elevation="4dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="+"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="14sp"
                app:backgroundTint="?attr/colorError"
                app:cornerRadius="100dp"
                tools:ignore="TouchTargetSizeCheck" />

        </LinearLayout>

    </RelativeLayout>

</androidx.cardview.widget.CardView>