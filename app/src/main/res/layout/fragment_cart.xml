<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:padding="@dimen/margin_small">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tu Carrito"
        android:textColor="?attr/colorPrimary"
        android:textSize="@dimen/text_size_xlarge"
        android:fontFamily="@font/poppins_bold"
        android:padding="@dimen/padding_large"
        android:background="?attr/colorSurfaceVariant"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_cart"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="8dp"/>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="?attr/colorSurfaceVariant">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/cart_total_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TOTAL: S/ 0.00"
                android:textSize="24sp"
                android:textStyle="bold"
                android:gravity="end"
                android:textColor="?attr/colorOnSurface"/>

            <TextView
                android:id="@+id/payment_status_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Selecciona un método de pago"
                android:textAlignment="center"
                android:layout_marginTop="12dp"
                android:textColor="?attr/colorOnSurface"/>

            <LinearLayout
                android:id="@+id/payment_buttons_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_efectivo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:backgroundTint="@color/success_green"
                    android:layout_weight="1"
                    android:text="Efectivo"
                    android:layout_marginEnd="6dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_tarjeta"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Tarjeta"
                    android:textColor="@android:color/white"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/btn_tarjeta_colors"
                    app:backgroundTint="@null"/>
            </LinearLayout>



            <com.google.android.material.button.MaterialButton
                android:id="@+id/checkout_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Realizar Pedido"
                android:layout_marginTop="18dp"
                app:backgroundTint="@color/badge_red"
                android:textColor="?attr/colorOnPrimary"/>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>