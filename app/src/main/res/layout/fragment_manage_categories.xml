<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:padding="@dimen/padding_large">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gestión de Categorías"
            android:textColor="?attr/colorPrimary"
            android:textSize="@dimen/text_size_xlarge"
            android:fontFamily="@font/poppins_bold"
            android:paddingBottom="@dimen/padding_medium"
            android:layout_marginBottom="@dimen/margin_medium"
            android:background="?attr/colorSurfaceVariant" />

        <EditText
            android:id="@+id/category_name_edit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre de la Categoría"
            android:inputType="text"
            android:background="?attr/colorSurfaceVariant"
            android:padding="@dimen/padding_medium"
            android:layout_marginBottom="@dimen/margin_medium"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOnSurfaceVariant"
            android:fontFamily="@font/poppins_regular" />

        <EditText
            android:id="@+id/category_description_edit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Descripción de la Categoría"
            android:inputType="textMultiLine"
            android:lines="4"
            android:gravity="top"
            android:background="?attr/colorSurfaceVariant"
            android:padding="@dimen/padding_medium"
            android:layout_marginBottom="@dimen/margin_large"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOnSurfaceVariant"
            android:fontFamily="@font/poppins_regular" />

        <Button
            android:id="@+id/add_category_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Añadir Nueva Categoría"
            android:textColor="?attr/colorOnPrimary"
            android:backgroundTint="?attr/colorPrimary"
            android:paddingVertical="@dimen/padding_medium"
            android:textAllCaps="false"
            android:fontFamily="@font/poppins_bold" />

    </LinearLayout>
</ScrollView>
