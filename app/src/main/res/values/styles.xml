<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="TextTitle">
        <item name="android:fontFamily">@font/poppins_bold</item>
        <item name="android:textSize">@dimen/text_size_xlarge</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item> </style>

    <style name="TextBody">
        <item name="android:fontFamily">@font/poppins_regular</item>
        <item name="android:textSize">@dimen/text_size_medium</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>

    <style name="TextToolbarTitle" parent="TextTitle">
        <item name="android:textSize">@dimen/text_size_large</item>
        <item name="android:textColor">?attr/colorOnPrimary</item> </style>

    <style name="ButtonPrimary" parent="Widget.Material3.Button.TextButton">
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="cornerRadius">@dimen/corner_radius_medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="ButtonSecondary" parent="ButtonPrimary">
        <item name="backgroundTint">?attr/colorSecondary</item>
        <item name="android:textColor">?attr/colorOnSecondary</item>
    </style>

    <style name="TextInputLayoutPrimary" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="hintTextColor">?attr/colorSecondary</item>
        <item name="boxStrokeColor">?attr/colorPrimary</item>
        <item name="errorTextColor">@color/red_vibrant</item>
        <item name="android:paddingBottom">0dp</item>
    </style>

    <style name="TextPoppinsRegular" parent="TextAppearance.AppCompat.Body1">
        <item name="fontFamily">@font/poppins_regular</item>
        <item name="android:textSize">@dimen/text_size_medium</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="TextPoppinsMedium" parent="TextAppearance.AppCompat.Medium">
        <item name="fontFamily">@font/poppins_medium</item>
        <item name="android:textSize">@dimen/text_size_medium</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="TextPoppinsBold" parent="TextAppearance.AppCompat.Large">
        <item name="fontFamily">@font/poppins_bold</item>
        <item name="android:textSize">@dimen/text_size_large</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

</resources>